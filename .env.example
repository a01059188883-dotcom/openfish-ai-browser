PORT=8787
BROWSER_WS_ENDPOINT=
OLLAMA_URL=http://127.0.0.1:11434
OPENFISH_MODEL=qwen2.5:3b
HEADLESS=true
ALLOWED_EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID
OPENFISH_DATA_DIR=.openfish
OPENFISH_MAX_TASKS=500
# Local single-computer mode: no API token for loopback browser tools and local HTTP MCP.
# Set false only when you want API-key authentication on local endpoints.
OPENFISH_LOCAL_NO_AUTH=true
OPENFISH_MCP_HTTP_HOST=127.0.0.1

# Optional Cloudflare relay agent (set secrets only in your local environment)
OPENFISH_RELAY_URL=
OPENFISH_RELAY_TOKEN=
OPENFISH_LOCAL_API_KEY=
OPENFISH_BRIDGE_URL=http://127.0.0.1:8787
OPENFISH_MCP_URL=http://127.0.0.1:8788/mcp
