{
  "manifest_version": 3,
  "name": "OpenFish AI Browser",
  "version": "1.2.0",
  "description": "Open-source AI browser companion for local or Cloudflare Browser Run automation.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OpenFish AI Browser"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
